# Copy to compose.env for local validation only. Production and staging use
# separately managed environment files and secrets; never commit their values.
DAMDAM_ENV_FILE=compose.env.example
DAMDAM_API_IMAGE=damdam-api:local
DAMDAM_POSTGRES_IMAGE=damdam-postgres-walg:local
API_PORT=8000
APP_ENV=development
POSTGRES_USER=damdam
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=damdam
JWT_SECRET=local-compose-secret-at-least-32-characters
CF_TUNNEL_TOKEN=replace-with-a-real-cloudflare-tunnel-token

# PostHog error tracking for the FastAPI container. Create the project first,
# then copy its project API key and regional ingestion host into production's
# runtime-only .env.production file. A blank key disables capture.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Dedicated WAL-G Cloudflare R2 credentials. Do not reuse application R2 keys.
WALG_R2_BUCKET=replace-with-walg-backup-bucket
WALG_R2_PREFIX=postgres
WALG_R2_ENDPOINT=https://replace-with-r2-account-id.r2.cloudflarestorage.com
WALG_R2_REGION=auto
WALG_R2_ACCESS_KEY_ID=replace-with-walg-r2-access-key-id
WALG_R2_SECRET_ACCESS_KEY=replace-with-walg-r2-secret-access-key
WALG_S3_FORCE_PATH_STYLE=true

# Uptime Kuma push-monitor base URL for the WAL-G backup-loop heartbeat
# (infrastructure.md §11.5) -- no query string, e.g.
# http://<hermes-tailscale-ip>:3001/api/push/<token>. Leave blank in
# local/dev/test; the backup loop treats a blank value as monitoring being
# unconfigured, not an error.
KUMA_PUSH_URL=

# --- chunk 26: observability, origins and rotation -------------------------

# Extra browser origins allowed to call the API, comma-separated. The dashboard
# URL is always included, so this is only for genuinely separate hosts (V05's
# consumer calling client, if it is served from its own domain).
#
# In production every origin must be HTTPS and must not be localhost, or the
# API refuses to start. There is no wildcard: `*` with credentials is refused
# by every browser anyway, and reads as though it works.
ADDITIONAL_BROWSER_ORIGINS=

# A bearer token letting a metrics scraper read /v1/admin/metrics without an
# operator session. Empty leaves the endpoint admin-only. At least 32
# characters in production -- it is a bearer credential.
#
# Give the scraper this rather than an operator login: an operator credential
# in a scrape config is how one ends up in a monitoring repository.
METRICS_SCRAPE_TOKEN=

# Activation-material keys this deployment can still UNSEAL with but no longer
# seals under. Format: `reference:base64key` pairs, comma-separated.
#
# Rotation is a two-step deployment and no migration: move the current
# ACTIVATION_MATERIAL_KEY / ACTIVATION_MATERIAL_KEY_REFERENCE pair here, set a
# new key and reference, deploy. Existing rows keep naming the key that sealed
# them and stay readable. Drop a retired key once no row references it.
#
# Leaving this empty while rotating the key destroys every sealed profile, and a
# Telnyx eSIM profile is one-time-use -- the customer's paid-for line is gone.
ACTIVATION_MATERIAL_RETIRED_KEYS=
