# Deliberately fake, local-only MinIO credentials for scripts/test-walg-pitr.sh.
# Production and staging must use distinct Cloudflare R2 credentials.
DAMDAM_ENV_FILE=compose.walg-test.env
POSTGRES_USER=damdam_test
POSTGRES_PASSWORD=damdam_test
POSTGRES_DB=damdam_test
WALG_R2_BUCKET=walg-test
WALG_R2_PREFIX=postgres
WALG_R2_ENDPOINT=http://minio:9000
WALG_R2_REGION=us-east-1
WALG_R2_ACCESS_KEY_ID=minio-test-access-key
WALG_R2_SECRET_ACCESS_KEY=minio-test-secret-key
WALG_S3_FORCE_PATH_STYLE=true
CF_TUNNEL_TOKEN=not-used-by-the-walg-test
