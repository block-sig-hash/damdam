NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1

# Firebase Web config for AC-19.1 browser push (SOS Alerts "Enable browser
# alerts"). These are public client identifiers, not secrets -- see
# data-model.md §6.26. Must match the same Firebase project as the API's
# FIREBASE_PROJECT_ID/FIREBASE_ACCESS_TOKEN.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
