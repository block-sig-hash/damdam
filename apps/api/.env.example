APP_ENV=development
DATABASE_URL=postgresql+psycopg://damdam:damdam@localhost:5432/damdam
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters

# US-01 OTP provider order and delivery-confirmation failover.
OTP_PROVIDER_PRIMARY=termii
OTP_PROVIDER_SECONDARY=twilio
OTP_FAILOVER_THRESHOLD_SECONDS=180
OTP_REQUEST_TIMEOUT_SECONDS=10

TERMII_BASE_URL=https://api.ng.termii.com
TERMII_API_KEY=
TERMII_SENDER_ID=DamDam
TERMII_WEBHOOK_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# HTO operator email verification and approval notifications
DASHBOARD_BASE_URL=http://localhost:3000
HTO_EMAIL_VERIFICATION_TTL_HOURS=24
RESEND_API_KEY=
RESEND_FROM_EMAIL=DamDam <operators@damdam.app>
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_APPROVAL_TEMPLATE=hto_account_approved
WHATSAPP_FAMILY_NOMINATION_TEMPLATE=family_contact_nominated
WHATSAPP_ACTIVATION_TEMPLATE=hto_package_activation
WHATSAPP_RECEIPT_TEMPLATE=retail_payment_receipt
WHATSAPP_ESIM_READY_TEMPLATE=esim_profile_ready
WHATSAPP_CHECKIN_TEMPLATE=pilgrim_safe_checkin
WHATSAPP_SOS_TEMPLATE=pilgrim_urgent_sos
WHATSAPP_SOS_CANCELLED_TEMPLATE=pilgrim_sos_cancelled
FIREBASE_PROJECT_ID=
# Short-lived OAuth 2 access token supplied/refreshed by the deployment secret agent.
FIREBASE_ACCESS_TOKEN=
ACTIVATION_BASE_URL=https://damdam.app/activate

# US-11 ranked eSIM issuance. Swap all three values without changing code.
ESIM_VENDOR_PRIMARY=monty_mobile
ESIM_VENDOR_SECONDARY=esim_access
ESIM_VENDOR_TERTIARY=1global
ESIM_REQUEST_TIMEOUT_SECONDS=20
MONTY_MOBILE_BASE_URL=
MONTY_MOBILE_API_KEY=
ESIM_ACCESS_BASE_URL=https://api.esimaccess.com
ESIM_ACCESS_ACCESS_CODE=
ESIM_ACCESS_SECRET_KEY=
# JSON map of "COUNTRY:GB" to vendor plan code, e.g. {"SA:5":"SA_5GB"}.
ESIM_ACCESS_PACKAGE_CODES={}
ESIM_ACCESS_ALLOCATION_TIMEOUT_SECONDS=35
ONEGLOBAL_BASE_URL=
ONEGLOBAL_API_KEY=

# Telnyx Programmable Voice / WebRTC
TELNYX_BASE_URL=https://api.telnyx.com/v2
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
# Base64-encoded 32-byte Ed25519 public key from Mission Control Portal.
TELNYX_PUBLIC_KEY=
VOICE_REQUEST_TIMEOUT_SECONDS=15
TELNYX_WEBHOOK_TOLERANCE_SECONDS=300

# US-09 retail payment order. Swap these values to change priority without code.
PAYMENT_PROCESSOR_PRIMARY=paystack
PAYMENT_PROCESSOR_SECONDARY=flutterwave
PAYMENT_REQUEST_TIMEOUT_SECONDS=15
PAYMENT_CALLBACK_URL=https://damdam.app/payment/callback
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Use S3 for production (Cloudflare R2 is S3-compatible). Filesystem is local-only.
INVOICE_STORAGE_BACKEND=filesystem
INVOICE_STORAGE_PATH=/tmp/damdam-invoices
INVOICE_S3_ENDPOINT_URL=
INVOICE_S3_ACCESS_KEY_ID=
INVOICE_S3_SECRET_ACCESS_KEY=
INVOICE_S3_BUCKET=
INVOICE_S3_REGION=auto
INVOICE_BANK_NAME=
INVOICE_ACCOUNT_NAME=DamDam Nigeria
INVOICE_ACCOUNT_NUMBER=
